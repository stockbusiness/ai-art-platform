// PR-02: Database and Tenant Foundation.
//
// Only Tenant / TenantDomain / TenantSetting are modeled here. Admin/User/
// LINE/booking/payment models are explicitly out of scope for PR-02 — see
// docs/architecture/DATABASE_BOUNDARIES.md.

generator client {
  provider = "prisma-client-js"
  // Generated into packages/database so the pnpm workspace's runtime code
  // imports it from there, instead of relying on hoisting into a shared
  // node_modules/@prisma/client that pnpm's isolated installs don't create.
  output   = "../packages/database/generated/client"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection (API request path). Can point at a connection
  // pooler (e.g. Supabase's Pooler) in staging/production.
  url       = env("DATABASE_URL")
  // Direct connection used for migrations, which must bypass a pooler.
  directUrl = env("DATABASE_DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  tenantKey      String       @unique @map("tenant_key") @db.VarChar(50)
  name           String       @db.VarChar(120)
  status         TenantStatus @default(ACTIVE)
  timezone       String       @default("Asia/Tokyo") @db.VarChar(64)
  defaultLocale  String       @default("ja-JP") @map("default_locale") @db.VarChar(16)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  domains  TenantDomain[]
  settings TenantSetting[]

  // PR-03A: nullable-tenant AdminUser/AdminLoginEvent rows relate back here
  // for Tenant-scoped admins only (SUPER_ADMIN rows have tenantId = NULL).
  adminUsers       AdminUser[]
  adminLoginEvents AdminLoginEvent[]

  @@map("tenants")
}

model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  host      String   @unique @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("tenant_domains")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(100)
  valueJson Json     @map("value_json")
  isSecret  Boolean  @default(false) @map("is_secret")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

// PR-03A: Admin Authentication, Session and RBAC Foundation.
//
// Admin login/session/RBAC only. No general User, LINE identity, or
// business-feature tables are added here — see
// docs/architecture/ADMIN_AUTH_POLICY.md.

enum AdminRole {
  SUPER_ADMIN
  TENANT_OWNER
  TENANT_ADMIN
  STAFF
  VIEWER
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum AdminLoginFailureReason {
  INVALID_CREDENTIALS
  TENANT_UNAVAILABLE
  ACCOUNT_DISABLED
  ACCOUNT_LOCKED
  IP_RATE_LIMITED
}

model AdminUser {
  id                String      @id @default(uuid()) @db.Uuid
  // NULL only for SUPER_ADMIN (global scope). Every other role must have a
  // tenantId — enforced by a DB CHECK constraint, not just the Domain
  // layer's AdminUser.create() invariant.
  tenantId          String?     @map("tenant_id") @db.Uuid
  // Always lower(btrim(...)) before it reaches here — packages/domain's
  // AdminEmail.create() normalizes, and a DB CHECK constraint mirrors it
  // so a raw INSERT bypassing the Domain layer still cannot store a
  // non-normalized email.
  email             String      @db.VarChar(254)
  passwordHash      String      @map("password_hash") @db.VarChar(255)
  name              String      @db.VarChar(120)
  role              AdminRole
  status            AdminStatus @default(ACTIVE)
  failedLoginCount  Int         @default(0) @map("failed_login_count")
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?   @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime    @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions    AdminSession[]
  loginEvents AdminLoginEvent[]

  // review-fix P1-3: lookups by Tenant, active-status filtering, and the
  // Lockout check all scan by one of these columns.
  @@index([tenantId])
  @@index([status])
  @@index([lockedUntil])
  @@map("admin_users")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  // SHA-256 hex digest of the Opaque Session Token. The raw token is never
  // stored — only set on the HttpOnly Session Cookie.
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  // SHA-256 hex digest of the CSRF Token. The raw token is set on the
  // (non-HttpOnly) CSRF Cookie so the browser can echo it back as a header.
  csrfTokenHash String    @map("csrf_token_hash") @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason") @db.VarChar(50)
  // HMAC-SHA256(AUTH_IP_HASH_SECRET, ip) — never the plaintext IP.
  ipHash        String?   @map("ip_hash") @db.VarChar(64)
  userAgentHash String?   @map("user_agent_hash") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // review-fix P1-3: Postgres does not auto-index FK columns, and
  // AuthenticateSessionUseCase's validity check filters by expiresAt/
  // revokedAt on every authenticated request.
  @@index([adminUserId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("admin_sessions")
}

model AdminLoginEvent {
  id            String                    @id @default(uuid()) @db.Uuid
  // Nullable: an event can be recorded before an AdminUser (or Tenant) was
  // ever resolved — e.g. IP_RATE_LIMITED, or an unknown email/tenantKey.
  adminUserId   String?                   @map("admin_user_id") @db.Uuid
  tenantId      String?                   @map("tenant_id") @db.Uuid
  // HMAC-SHA256(AUTH_IP_HASH_SECRET, normalizedEmail) — never the
  // plaintext email.
  emailHash     String                    @map("email_hash") @db.VarChar(64)
  success       Boolean
  failureReason AdminLoginFailureReason?  @map("failure_reason")
  ipHash        String?                   @map("ip_hash") @db.VarChar(64)
  userAgentHash String?                   @map("user_agent_hash") @db.VarChar(64)
  requestId     String                    @map("request_id") @db.VarChar(100)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // review-fix P1-3: (ipHash, success, createdAt) backs the IP-level rate
  // limit's countRecentFailuresByIpHash query; the others back per-admin
  // history and audit queries by time.
  @@index([createdAt])
  @@index([adminUserId, createdAt])
  @@index([emailHash, createdAt])
  @@index([ipHash, success, createdAt])
  @@map("admin_login_events")
}
