# PR-01/PR-02 foundation only. No LINE, Stripe, or provider secrets are
# introduced yet. Real secrets must never be committed to this file or to
# any file in this repository.

# Shared across all apps (see packages/config)
NODE_ENV=development
LOG_LEVEL=info

# apps/api only — never exposed to a browser bundle (see packages/config).
# The values below match the local Docker Postgres in compose.yaml
# (`pnpm db:up`) and are not secrets outside a developer's own machine.
DATABASE_URL=postgresql://aiart:aiart_local@localhost:5432/ai_art_platform?schema=public
DATABASE_DIRECT_URL=postgresql://aiart:aiart_local@localhost:5432/ai_art_platform?schema=public
