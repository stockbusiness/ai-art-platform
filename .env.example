# PR-01/PR-02 foundation only. No LINE, Stripe, or provider secrets are
# introduced yet. Real secrets must never be committed to this file or to
# any file in this repository.

# Shared across all apps (see packages/config)
NODE_ENV=development
LOG_LEVEL=info

# apps/api only — never exposed to a browser bundle (see packages/config).
# The values below match the local Docker Postgres in compose.yaml
# (`pnpm db:up`) and are not secrets outside a developer's own machine.
DATABASE_URL=postgresql://aiart:aiart_local@localhost:5432/ai_art_platform?schema=public
DATABASE_DIRECT_URL=postgresql://aiart:aiart_local@localhost:5432/ai_art_platform?schema=public

# PR-03A: Admin Authentication / Session / RBAC (apps/api only).
# Exact-match CORS origin for apps/admin-web's local dev server.
ADMIN_WEB_ORIGIN=http://localhost:5173
# ADMIN_SESSION_TTL_SECONDS=28800
# ADMIN_LOGIN_WINDOW_SECONDS=900
# ADMIN_LOGIN_ACCOUNT_MAX_FAILURES=5
# ADMIN_LOGIN_IP_MAX_FAILURES=20
# ADMIN_LOCKOUT_SECONDS=900
# AUTH_IP_HASH_SECRET must be a real secret in any shared environment — the
# placeholder below is for local development only and must be replaced,
# never reused, in staging/production.
AUTH_IP_HASH_SECRET=local-development-only-change-me-please
# Number of trusted reverse-proxy hops in front of the API (Express's
# `trust proxy`) — controls how much of X-Forwarded-For is trusted when
# computing the client IP for rate limiting / audit hashing. Left unset
# here (defaults to 0 — trust nothing) since local dev has no proxy in
# front of it. NODE_ENV=production requires this to be set explicitly to
# the real hop count — never `true` (unconditional trust).
# ADMIN_TRUST_PROXY_HOPS=0
