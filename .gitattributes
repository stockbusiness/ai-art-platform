# Force LF line endings for all text files, regardless of the developer's
# OS or local git config. This keeps Prettier's `endOfLine: "lf"` setting
# (prettier.config.js) consistent across macOS/Linux/Windows checkouts —
# without this, Windows checkouts with core.autocrlf=true convert LF to
# CRLF on checkout, which then fails `pnpm format:check` on every file.
* text=auto eol=lf

# Binary files should never be line-ending-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
