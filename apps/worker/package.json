{
  "name": "@ai-art-platform/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone worker process foundation. No job processing yet.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ai-art-platform/config": "workspace:*",
    "@ai-art-platform/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
